# Senac Arena — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores

SECRET_KEY=django-insecure-senac-arena-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Banco de dados (True = SQLite local | False = PostgreSQL / Supabase)
USE_SQLITE=True

# Banco de dados PostgreSQL / Supabase (usado quando USE_SQLITE=False)
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA_SUPABASE
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require

# Produção (deixar vazio em dev)
CORS_ALLOWED_ORIGINS=

